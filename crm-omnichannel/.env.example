NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — usada pelo painel Master (app/master/nova-empresa) pra criar
# usuários via Auth Admin API. Nunca expor com o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública desta aplicação (sem barra no final) — usada pra registrar o
# webhook da Evolution API (ex: https://app.suamarca.com.br).
NEXT_PUBLIC_APP_URL=

# Servidor Evolution API (self-hosted) usado pra conectar o WhatsApp.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Segredo próprio (gerado por você, ex: openssl rand -hex 24) usado na URL
# do webhook (/api/whatsapp/webhook/<segredo>) pra impedir que qualquer um
# poste eventos falsos nesse endpoint.
EVOLUTION_WEBHOOK_SECRET=
